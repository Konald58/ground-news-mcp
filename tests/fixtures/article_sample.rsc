n:0:props:children:4:props:children:0:props:articleSources:211:sourceInfo","isOriginatingWireSrc":false},{"articleId":null,"createdAt":"2026-05-08T20:27:40.000Z","date":"2026-05-08T18:41:00.000Z","description":"President Trump said that the leaders of Russia and Ukraine have agreed to his request for a three-day ceasefire and an exchange of prisoners.","originalDescription":null,"lang":"en","paywall":"no","refId":"e7ef2e4a-a6a4-4e34-ba01-3f304b1b1180","sortData":"$86:props:children:0:props:children:4:props:children:0:props:articleSources:245:sortData","specialIcon":null,"title":"Trump says Russia and Ukraine agreed to his request for three-day ceasefire, prisoner swap","originalTitle":null,"url":"https://www.ksbw.com/article/trump-russia-ukraine-ceasefire-prisoner-exchange/71255001","wireStoryId":"6ec35832-21fb-4a99-a237-774eb1c76c76","sourceInfo":"$86:props:children:0:props:children:4:props:children:0:props:articleSources:245:sourceInfo","isOriginatingWireSrc":false},{"articleId":null,"createdAt":"2026-05-08T20:04:48.000Z","date":"2026-05-08T18:41:00.000Z","description":"President Trump said that the leaders of Russia and Ukraine have agreed to his request for a three-day ceasefire and an exchange of prisoners.","originalDescription":null,"lang":"en","paywall":"no","refId":"7bf22535-42f8-4430-ac6b-cf4e4e2b6804","sortData":"$86:props:children:0:props:children:4:props:children:0:props:articleSources:264:sortData","specialIcon":null,"title":"Trump says Russia and Ukraine agreed to his request for three-day ceasefire, prisoner swap","originalTitle":null,"url":"https://www.4029tv.com/article/trump-russia-ukraine-ceasefire-prisoner-exchange/71255001","wireStoryId":"6ec35832-21fb-4a99-a237-774eb1c76c76","sourceInfo":"$86:props:children:0:props:children:4:props:children:0:props:articleSources:264:sourceInfo","isOriginatingWireSrc":false}]},{"articleId":null,"createdAt":"2026-05-08T19:35:06.000Z","date":"2026-05-08T18:40:00.000Z","description":"WASHINGTON >> President Donald Trump today announced on social media that there would be a three-day ceasefire in the war between Russia and Ukraine from May 9 until May 11 to mark the end of World War Two for the Russians.","originalDescription":null,"lang":"en","paywall":"no","refId":"4ee2bd3f-bbff-4509-8340-b9dbfb2a6908","sortData":"$86:props:children:0:props:children:4:props:children:0:props:articleSources:59:sortData","specialIcon":null,"title":"Trump announces 3-day ceasefire between Ukraine and Russia | Honolulu Star-Advertiser","originalTitle":null,"url":"https://www.staradvertiser.com/2026/05/08/breaking-news/trump-announces-3-day-ceasefire-between-ukraine-and-russia/","wireStoryId":null,"sourceInfo":"$86:props:children:0:props:children:4:props:children:0:props:articleSources:59:sourceInfo"},{"articleId":null,"createdAt":"2026-05-08T22:13:14.000Z","date":"2026-05-08T18:39:57.000Z","description":"From 9th to 11th May, all fighting activities will rest. Putin, Selensky and Trump have agreed on a three-day ceasefire. The exchange of 1,000 prisoners of war is also planned. Trump's envoys will travel to Kiev in the coming weeks.","originalDescription":"Vom 9. bis 11. Mai sollen alle Kampfhandlungen ruhen. Putin, Selenskij und Trump haben sich auf eine dreitägige Feuerpause geeinigt. Geplant ist auch der Austausch von je 1.000 Kriegsgefangenen. Trumps Gesandte sollen in den kommenden Wochen nach Kiew reisen.","lang":"de","paywall":"no","refId":"4bea3fe0-8ab4-4ea3-8624-11ed6c064634","sortData":"$86:props:children:0:props:children:4:props:children:0:props:articleSources:73:sortData","specialIcon":null,"title":"\"Start of the End\": Trump Announces Ceasefire in the Ukraine War","originalTitle":"\"Anfang vom Ende\": Trump verkündet Waffenruhe im Ukraine-Krieg","url":"https://kurier.at/politik/ausland/ukraine-russland-donald-trump-waffenruhe-krieg/403158134","wireStoryId":null,"sourceInfo":"$86:props:children:0:props:children:4:props:children:0:props:articleSources:73:sourceInfo"},{"articleId":null,"createdAt":"2026-05-09T07:45:22.000Z","date":"2026-05-08T18:39:13.000Z","description":"Zelensky: 'The US ensures that Moscow respects it' (ANSA)","originalDescription":"Zelensky: 'Gli Usa garantiscano che Mosca la rispetti' (ANSA)","lang":"it","paywall":"sometimes","refId":"496f8628-24df-4ce4-8dfa-115d20510b04","sortData":"$86:props:children:0:props:children:4:props:children:0:props:articleSources:81:sortData","specialIcon":null,"title":"Trump: \"There Will Be Three Days of Truce in Ukraine, From 9 to 11 May\"","originalTitle":"Trump: \"Ci saranno tre giorni di tregua in Ucraina, dal 9 all'11 maggio\"","url":"https://www.ansa.it/sito/notizie/mondo/2026/05/08/trump-ci-saranno-tre-giorni-di-tregua-in-ucraina-dal-9-all11-maggio_e828d0fe-aaf2-41b5-9421-be495a2b82e5.html","wireStoryId":null,"sourceInfo":"$86:props:children:0:props:children:4:props:children:0:props:articleSources:81:sourceInfo"},{"articleId":null,"createdAt":"2026-05-08T18:45:55.000Z","date":"2026-05-08T18:38:40.000Z","description":"President Trump said Friday that Ukraine and Russia will embark on a three-day cease-fire that could be the \"beginning of the end\" of the more than four-year-old war — as both nations pause to celebrate the Soviet victory over Nazi Germany in World War II.","originalDescription":null,"lang":"en","paywall":"no","refId":"399cd68a-255e-4b98-a08c-d34fbca0ad01","sortData":"$86:props:children:0:props:children:4:props:children:0:props:articleSources:14:sortData","specialIcon":null,"title":"Trump announces three-day Ukraine-Russia cease-fire, prisoner swap","originalTitle":null,"url":"https://nypost.com/2026/05/08/us-news/trump-announces-three-day-ukraine-russia-cease-fire-prisoner-swap/","wireStoryId":null,"sourceInfo":"$86:props:children:0:props:children:4:props:children:0:props:articleSources:14:sourceInfo"},{"articleId":null,"createdAt":"2026-05-09T02:47:45.000Z","date":"2026-05-08T18:38:10.000Z","description":"A three-day truce. Donald Trump announced it on Truth: from the 9th (i.e. tomorrow) to the 11th of May there will be a ceasefire in the war in Ukraine. The reason is that Russia celebrates victory in the Second World War. I am pleased to announce that there will be a three-day ceasefire in the war between Russia and Ukraine, wrote the U.S. president adding that the break of hostilities also provides for the exchange of a thousand prisoners for e…","originalDescription":"Una tregua di tre giorni. Lo ha annunciato Donald Trump su Truth: dal 9 (cioè domani) all’11 di maggio è previsto il cessate il fuoco nella guerra in Ucraina. La ragione è che la Russia celebra la vittoria nella Seconda Guerra Mondiale. “Sono lieto di annunciare che vi sarà un cessate il fuoco di tre giorni nella guerra tra Russia e Ucraina”, ha scritto il presidente statunitense aggiungendo che la pausa delle ostilità prevede anche lo scambio d…","lang":"it","paywall":"no","refId":"d391861e-bdf3-47d0-9d26-38c75f84060f","sortData":"$86:props:children:0:props:children:4:props:children:0:props:articleSources:84:sortData","specialIcon":null,"title":"Truce Ukraine, Trump Announces Ceasefire 9-11 May","originalTitle":"Tregua Ucraina, Trump annuncia cessate il fuoco 9-11 maggio","url":"https://www.ilfattoquotidiano.it/2026/05/08/tregua-ucraina-trump-cessate-fuoco-notizie/8379990/","wireStoryId":null,"sourceInfo":"$86:props:children:0:props:children:4:props:children:0:props:articleSources:84:sourceInfo"},{"articleId":null,"createdAt":"2026-05-08T20:09:27.000Z","date":"2026-05-08T18:36:03.000Z","description":"The ceasefire, which Donald Trump said would last May 9 to 11, coincides with Russia’s Victory Day celebrations, the US president said in a social media post.","originalDescription":null,"lang":"en","paywall":"yes","refId":"14b5f9a7-b338-4857-9f92-1619a535900f","sortData":"$86:props:children:0:props:children:4:props:children:0:props:articleSources:12:sortData","specialIcon":null,"title":"Russia, Ukraine agree to three-day ceasefire, says Trump","originalTitle":null,