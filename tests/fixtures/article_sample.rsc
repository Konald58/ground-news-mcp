administrative_area_level_1"},{"id":"CA","name":"Canada","type":"country"}],"placeId":"SaultSte.Marie,AlgomaDistrict,ON,CA","storyCount":95487,"slug":"sootodaycom","factuality":"high","owners":[{"id":1550,"category":"mediaConglomerate","name":"Village Media"}]}},{"articleId":null,"createdAt":"2026-05-08T19:05:39.000Z","date":"2026-05-08T18:53:35.000Z","description":"According to the US President, the ceasefire will start on Saturday. Ukrainian President Selensky confirmed Trump's statements.","originalDescription":"Laut Angaben des US-Präsidenten gilt die Feuerpause ab Samstag. Der ukrainische Präsident Selenskij bestätigte Trumps Aussagen.","lang":"de","paywall":"no","refId":"93ec31a1-9737-4ac1-b85d-6c627bdc8d61","sortData":{"locality":{"index":197,"labelData":"international","flag":"https://groundnews.b-cdn.net/assets/flags/120_120/AT.png"},"bias":{"index":230,"labelData":"leanRight"},"date":{"index":266,"labelData":"2026-05-08T18:53:35.000Z"}},"specialIcon":null,"title":"Trump Announces Three-Day Ceasefire in Ukraine","originalTitle":"Trump kündigt dreitägige Waffenruhe in der Ukraine an","url":"https://www.diepresse.com/23125830/trump-kuendigt-dreitaegige-waffenruhe-in-der-ukraine-an","wireStoryId":null,"sourceInfo":{"bias":"leanRight","biasRatings":[{"reviewerId":"c17ff2cc-b919-439a-b390-1a9a4d08ba62","politicalBias":"leanRight","referenceUrl":"https://mediabiasfactcheck.com/die-presse/","sourceInfoId":"29db6099-0cd2-46ed-921e-b9abe24e9766","reviewer":{"id":"c17ff2cc-b919-439a-b390-1a9a4d08ba62","name":"Media Bias/Fact Check","icon":"https://b-cdn.ground.news/assets/external_source_reviewer_icons/mediaBiasFactCheck.png"}}],"icon":"https://groundnews.b-cdn.net/interests/acd4c6f540bfdf765b66e53ce633d69d85d4f5da.jpg","id":"29db6099-0cd2-46ed-921e-b9abe24e9766","interestId":"bc3979e2-425d-41a5-89ed-4d460110d685","location":{"lat":48.192986,"lon":16.375006},"name":"Die Presse","paywall":"no","place":[{"id":"Vienna,Vienna,AT","name":"Vienna","type":"locality"},{"id":"Vienna,AT","name":"Vienna","type":"administrative_area_level_1"},{"id":"AT","name":"Austria","type":"country"}],"placeId":"Vienna,Vienna,AT","storyCount":95185,"slug":"die-presse","factuality":"high","owners":[{"id":1457,"category":"mediaConglomerate","name":"Styria Media Group"}]}},{"articleId":null,"createdAt":"2026-05-08T19:04:54.000Z","date":"2026-05-08T18:53:38.000Z","description":"U.S. President Donald Trump announced Friday a three-day ceasefire, 9, 10 and 11 May, on the occasion of Victory Day after his Russian and Ukrainian counterparts, Vladimir Putin and Volodimir Zelenski, have accepted the proposal.\"This ceasefire will include the suspension of all military activity and an exchange of 1,000 prisoners from each country. I made this request directly and I greatly appreciate your acceptance by President Vladimir Putin…","originalDescription":"El presidente de Estados Unidos, Donald Trump, ha anunciado este viernes un alto el fuego de tres días, 9, 10 y 11 de mayo, con motivo del Día de Victoria después de que sus homólogos ruso y ucraniano, Vladimir Putin y Volodimir Zelenski, hayan aceptado la propuesta.\"Este alto el fuego incluirá la suspensión de toda actividad militar y un intercambio de 1.000 prisioneros de cada país. Esta solicitud la hice directamente yo y agradezco enormement…","lang":"es","paywall":"no","refId":"9853f677-31d0-47c0-8640-4a232c6d0a96","sortData":{"locality":{"index":154,"labelData":"international","flag":"https://groundnews.b-cdn.net/assets/flags/120_120/ES.png"},"bias":{"index":106,"labelData":"center"},"date":{"index":267,"labelData":"2026-05-08T18:53:38.000Z"}},"specialIcon":null,"title":"Trump Announces Three-Day Ceasefire Between Russia and Ukraine on Victory Day · Global Voices","originalTitle":"Trump anuncia un alto el fuego de tres días entre Rusia y Ucrania con motivo del Día de la Victoria","url":"https://www.20minutos.es/internacional/donald-trump-anuncia-alto-fuego-tres-dias-entre-rusia-ucrania-motivo-dia-victoria_696