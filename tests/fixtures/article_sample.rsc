ce_reviewer_icons/allSides.png"}},{"reviewerId":"c17ff2cc-b919-439a-b390-1a9a4d08ba62","politicalBias":"leanLeft","referenceUrl":"https://mediabiasfactcheck.com/kyiv-independent-bias/","sourceInfoId":"44adcb14-f685-4d29-b8da-aff38cd45716","reviewer":{"id":"c17ff2cc-b919-439a-b390-1a9a4d08ba62","name":"Media Bias/Fact Check","icon":"https://b-cdn.ground.news/assets/external_source_reviewer_icons/mediaBiasFactCheck.png"}}],"icon":"https://groundnews.b-cdn.net/interests/0e3989c482f8ea79a9d69a95c68669e7a602c4d5.jpg","id":"44adcb14-f685-4d29-b8da-aff38cd45716","interestId":"9096391c-e8ea-4689-9acb-ad47625230c1","location":{"lat":50.459508,"lon":30.55018},"name":"The Kyiv Independent","paywall":"no","place":[{"id":"Kyiv,KyivCity,UA","name":"Kyiv","type":"locality"},{"id":"KyivCity,Kyivcity,UA","name":"Kyiv City Municipality","type":"administrative_area_level_2"},{"id":"Kyivcity,UA","name":"Kyiv City Region","type":"administrative_area_level_1"},{"id":"UA","name":"Ukraine","type":"country"}],"placeId":"Kyiv,KyivCity,UA","storyCount":27168,"slug":"the-kyiv-independent","factuality":"high","owners":[]}},{"articleId":null,"createdAt":"2026-05-08T22:10:26.000Z","date":"2026-05-08T19:15:00.000Z","description":"(The Center Square) – More than four years into the war between Russia and Ukraine, President Donald Trump has announced a three-day ceasefire between the two countries.","originalDescription":null,"lang":"en","paywall":"no","refId":"37e765e2-41a6-497b-9e59-5cb78dd57882","sortData":{"locality":{"index":343,"labelData":"other","flag":null},"bias":{"index":156,"labelData":"center"},"date":{"index":308,"labelData":"2026-05-08T19:15:00.000Z"}},"specialIcon":null,"title":"Trump announces three-day ceasefire, prisoner swap between Russia, Ukraine","originalTitle":null,"url":"https://www.columbiagorgenews.com/news/national/trump-announces-three-day-ceasefire-prisoner-swap-between-russia-ukraine/article_28de3d4e-1dd2-5b87-9902-f8029802bb5e.html","wireStoryId":"1e08216b-d4bd-47fb-9570-31f1e5a74dec","sourceInfo":{"bias":"center","biasRatings":[{"reviewerId":"c17ff2cc-b919-439a-b390-1a9a4d08ba62","politicalBias":"center","referenceUrl":"https://mediabiasfactcheck.com/columbia-gorge-news-bias-and-credibility/","sourceInfoId":"2c0499c0-4ebd-4d8f-b0d1-d384e33c95e5","reviewer":{"id":"c17ff2cc-b919-439a-b390-1a9a4d08ba62","name":"Media Bias/Fact Check","icon":"https://b-cdn.ground.news/assets/external_source_reviewer_icons/mediaBiasFactCheck.png"}}],"icon":"https://groundnews.b-cdn.net/interests/8f10d5f8043fc1967c764ed8a2636d35fd9de1b1.jpg","id":"2c0499c0-4ebd-4d8f-b0d1-d384e33c95e5","interestId":"ac286a2c-7f4d-4e28-9991-aab46591eb6c","location":null,"name":"Columbia Gorge News","paywall":"no","place":[],"placeId":null,"storyCount":27100,"slug":"columbia-gorge-news","factuality":"high","owners":[]}},{"articleId":null,"createdAt":"2026-05-08T18:57:05.000Z","date":"2026-05-08T18:46:05.000Z","description":"President Donald Trump of the United States announced a three-day cease-fire in the Russian-Ukraine war, which he posted on the Truth social network.","originalDescription":"Президент США Дональд Трамп заявил о трехдневном прекращении огня в российско-украинской войне. Соответствующий пост он опубликовал в соцсети Truth.","lang":"ru","paywall":"no","refId":"3264d2b5-6569-482d-8281-036e6d491047","sortData":{"locality":{"index":186,"labelData":"international","flag":"https://groundnews.b-cdn.net/assets/flags/120_120/LV.png"},"bias":{"index":2,"labelData":"left"},"date":{"index":245,"labelData":"2026-05-08T18:46:05.000Z"}},"specialIcon":null,"title":"Trump Announced a Truce: Russia and Ukraine Will Not Fight From 9 to 11 May.","originalTitle":"Трамп объявил о перемирии: Россия и Украина не будут воевать с 9 по 11 мая. Киев и Москва это подтвердили","url":"https://meduza.io/news/2026/05/08/tramp-ob-yavil-o-peremirii-rossiya-i-ukraina-ne-budut-voevat-s-9-po-11-maya-utverzhdaet-on","wireStoryId":null,"sourceInfo":{"bias":"left","biasRatings":[{"reviewerId":"c17ff2cc-b919-439a-b390-1a9a4d08ba62","politicalBias":"left","referenceUrl":"https://mediabiasfactcheck.com/meduza/","sourceInfoId":"18745771-7b01-4b36-9a34-885def1689c2","reviewer":{"id":"c17ff2cc-b919-439a-b390-1a9a4d08ba62","name":"Media Bias/Fact Check","icon":"https://b-cdn.ground.news/assets/external_source_reviewer_icons/mediaBiasFactCheck.png"}}],"icon":"https://groundnews.b-cdn.net/interests/0a4c7b650587acea571a5fea73120a85c5725562.jpg","id":"18745771-7b01-4b36-9a34-885def1689c2","interestId":"ca3552dc-79b8-4d5b-9da7-b66f901dd60a","location":{"lat":56.960047,"lon":24.1092},"name":"Meduza","paywall":"no","place":[{"id":"Riga,LV","name":"Riga","type":"locality"},{"id":"LV","name":"Latvia","type":"country"}],"placeId":"Riga,LV","storyCount":26821,"slug":"meduza","factuality":"high","owners":[]}},{"articleId":null,"createdAt":"2026-05-08T19:27:17.000Z","date":"2026-05-08T18:14:00.000Z","description":"There will be a three-day ceasefire in the war in Ukraine, US President Donald Trump announced on Friday. According to his statement on the social network Truth Social, it will last from May 9 to 11. The ceasefire will include an exchange of 1,000 prisoners on each side. Trump believes this is the beginning of the end of this war, which Moscow started in February 2022.","originalDescription":"Ve válce na Ukrajině bude třídenní příměří, oznámil v pátek americký prezident Donald Trump. Trvat má podle jeho vyjádření na sociální síti Truth Social od 9. do 11. května. Součástí klidu zbraní bude výměna 1000 zajatců na každé straně. Trump věří, že to je začátek konce této války, kterou Moskva zahájila v únoru 2022.","lang":"cs","paywall":"no","refId":"c49ccfee-08c9-42e8-874f-b8c69ed0edc4","sortData":{"locality":{"index":344,"labelData":"other","flag":null},"bias":{"index":382,"labelData":null},"date":{"index":69,"labelData":"2026-05-08T18:14:00.000Z"}},"specialIcon":null,"title":"Trump Announces Three-Day Ceasefire in Ukraine War. There Will Also Be a Prisoner Exchange","originalTitle":"Trump oznámil třídenní příměří ve válce na Ukrajině. Bude i výměna zajatců","url":"https://www.denik.cz/ze_sveta/valka-na-ukrajine-donald-trump-primeri-vymena-zajatcu.html","wireStoryId":null,"sourceInfo":{"bias":"unknown","biasRatings":[],"icon":"https://groundnews.b-cdn.net/interests/76dd37f841485052e35914a9b786d79fecb45ca8.jpg","id":"d75c0eaa-cfe2-42d1-9898-5fdb9dc74e4f","interestId":"61357d93-f2cf-4342-b77d-2bbf9e2df0d6","location":null,"name":"Deník.cz","paywall":"no","place":[],"placeId":null,"storyCount":26773,"slug":"denikcz","factuality":"unknown","owners":[]}},{"articleId":null,"createdAt":"2026-05-08T20:16:46.000Z","date":"2026-05-08T18:51:29.000Z","description":"US President Donald Trump has announced a three-day ceasefire between Ukraine and Russia. The ceasefire is valid from tomorrow through Monday, according to Trump on Truth Social. He states that Russia and Ukraine have agreed to it.","originalDescription":"De Amerikaanse president Donald Trump heeft aangekondigd dat er een driedaags bestand komt tussen Oekraïne en Rusland. Het staakt-het-vuren geldt van morgen tot en met maandag, aldus Trump op Truth Social. Hij stelt dat Rusland en Oekraïne ermee hebben ingestemd.","lang":"nl","paywall":"no","refId":"799d0a5d-b40c-49bd-9e95-21d78729ec06","sortData":{"locality":{"index":345,"labelData":"other","flag":null},"bias":{"index":461,"labelData":null},"date":{"index":260,"labelData":"2026-05-08T18:51:29.000Z"}},"specialIcon":null,"title":"Trump: Three-Day Ceasefire Between Ukraine and Russia","originalTitle":"Trump: driedaags staakt-het-vuren tussen Oekraïne en Rusland","url":"https://www.rtl.nl/nieuws/buitenland/artikel/5599417/trump-kondigt-driedaags-bestand-tussen-oekraine-en-rusland-aan","wireStoryId":"6d763828-20be-4ff7-be2d-ee08b01358da","sourceInfo":{"bias":"unknown","biasRatings":[],"icon":"https://groundnews.b-cdn.net/assets/letterIcons/square/FF6D00/R.png","id":"89da2d7e-8f0a-4ba0-9e56-8613be53547c","interestId":"7b70f4f3-ce1c