ago","type":"locality"},{"id":"CookCounty,IL,US","name":"Cook County","type":"administrative_area_level_2"},{"id":"IL,US","name":"Illinois","type":"administrative_area_level_1"},{"id":"US","name":"United States","type":"country"}],"placeId":"Chicago,CookCounty,IL,US","storyCount":113580,"slug":"chicago-tribune","factuality":"veryHigh","owners":[{"id":172,"category":"privateEquity","name":"Alden Global Capital"}]}},{"articleId":null,"createdAt":"2026-05-09T01:10:14.000Z","date":"2026-05-08T16:06:00.000Z","description":"Saturday is Victory Day in Russia, a holiday that commemorates its victory over Nazi Germany 81 years ago in World War II.","originalDescription":null,"lang":"en","paywall":"no","refId":"1a04378e-4cb3-43b0-8732-bf80604b3c91","sortData":{"locality":{"index":20,"labelData":"national","flag":"https://groundnews.b-cdn.net/assets/flags/120_120/US.png"},"bias":{"index":99,"labelData":"center"},"date":{"index":28,"labelData":"2026-05-08T16:06:00.000Z"}},"specialIcon":null,"title":"Trump says Russia and Ukraine have agreed to his request for 3-day ceasefire","originalTitle":null,"url":"http://www.spectrumnews1.com/ky/louisville/international/2026/05/08/trump-russia-ukraine-agreement-t3-day-ceasefire-prisoner-swap","wireStoryId":"c3e9f8f3-396a-4c06-b438-6e0f7c95bdaa","sourceInfo":{"bias":"center","biasRatings":[{"reviewerId":"0b06b55d-d3d4-4653-b4db-b22c77d812f7","politicalBias":"center","referenceUrl":"https://www.adfontesmedia.com/","sourceInfoId":"b6a7439c-ca67-43ae-ab8a-a7f6ba11992b","reviewer":{"id":"0b06b55d-d3d4-4653-b4db-b22c77d812f7","name":"Ad Fontes Media","icon":"https://b-cdn.ground.news/assets/external_source_reviewer_icons/adFontes.png"}},{"reviewerId":"c17ff2cc-b919-439a-b390-1a9a4d08ba62","politicalBias":"center","referenceUrl":"https://mediabiasfactcheck.com/worcester-spectrum-news/","sourceInfoId":"b6a7439c-ca67-43ae-ab8a-a7f6ba11992b","reviewer":{"id":"c17ff2cc-b919-439a-b390-1a9a4d08ba62","name":"Media Bias/Fact Check","icon":"https://b-cdn.ground.news/assets/external_source_reviewer_icons/mediaBiasFactCheck.png"}}],"icon":"https://groundnews.b-cdn.net/interests/3610353d750c7ed7094ea5e82a75a932c47f1789.jpg","id":"b6a7439c-ca67-43ae-ab8a-a7f6ba11992b","interestId":"ef341b7e-cc48-494c-b932-a63a3bb0ffaa","location":{"lat":36.200719,"lon":-93.960186},"name":"Spectrum News","paywall":"no","place":[{"id":"US","name":"United States","type":"country"}],"placeId":"US","storyCount":112883,"slug":"spectrum-news","factuality":"high","owners":[{"id":149,"category":"mediaConglomerate","name":"Advance Publications"},{"id":160,"category":"mediaConglomerate","name":"Liberty Media"},{"id":429,"category":"privateEquity","name":"Capital Group Companies"},{"id":431,"category":"privateEquity","name":"The Vanguard Group"},{"id":1067,"category":"corporation","name":"Mitsubishi UFJ Financial Group"},{"id":1069,"category":"corporation","name":"Nippon Life"},{"id":1070,"category":"corporation","name":"Meiji Yasuda Life"},{"id":1072,"category":"corporation","name":"Norinchukin Bank"},{"id":1075,"category":"corporation","name":"Resona Holdings"},{"id":1086,"category":"corporation","name":"Sumitomo Mitsui Trust Holdings"},{"id":1296,"category":"billionaire","name":"Masayoshi Son"},{"id":1300,"category":"privateEquity","name":"JPMorgan Chase"},{"id":1303,"category":"privateEquity","name":"Citigroup"},{"id":1305,"category":"privateEquity","name":"Baillie Gifford"}]}},{"articleId":null,"createdAt":"2026-05-08T22:13:14.000Z","date":"2026-05-08T18:39:57.000Z","description":"From 9th to 11th May, all fighting activities will rest. Putin, Selensky and Trump have agreed on a three-day ceasefire. The exchange of 1,000 prisoners of war is also planned. Trump's envoys will travel to Kiev in the coming weeks.","originalDescription":"Vom 9. bis 11. Mai sollen alle Kampfhandlungen ruhen. Putin, Selenskij und Trump haben sich auf eine dreitägige Feuerpause geeinigt. Geplant ist auch der Austausch von je 1.000 Kriegsgefangenen. Trumps Gesandte sollen in den kommenden Wochen nach Kiew reisen.","lang":"de","paywall":"no","refId":"4bea3fe0-8ab4-4ea3-8624-11ed6c064634","sortData":{"locality":{"index":283,"labelData":"other","flag":null},"bias":{"index":224,"labelData":"leanRight"},"date":{"index":204,"labelData":"2026-05-08T18:39:57.000Z"}},"specialIcon":null,"title":"\"Start of the End\": Trump Announces Ceasefire in the Ukraine War","originalTitle":"\"Anfang vom Ende\": Trump verkündet Waffenruhe im Ukraine-Krieg","url":"https://kurier.at/politik/ausland/ukraine-russland-donald-trump-waffenruhe-krieg/403158134","wireStoryId":null,"sourceInfo":{"bias":"leanRight","biasRatings":[{"reviewerId":"c17ff2cc-b919-439a-b390-1a9a4d08ba62","politicalBias":"leanRight","referenceUrl":"https://mediabiasfactcheck.com/kurier-austria-bias-and-credibility/","sourceInfoId":"f1cfd348-e238-4139-b965-8910e61a5e79","reviewer":{"id":"c17ff2cc-b919-439a-b390-1a9a4d08ba62","name":"Media Bias/Fact Check","icon":"https://b-cdn.ground.news/assets/external_source_reviewer_icons/mediaBiasFactCheck.png"}}],"icon":"https://groundnews.b-cdn.net/interests/668f7cd280ba979f6f0dcf26db20ef2e3dbe0134.jpg","id":"f1cfd348-e238-4139-b965-8910e61a5e79","interestId":"817173ff-13cc-4c27-b29d-f231dd552035","location":null,"name":"Kurier","paywall":"no","place":[],"placeId":null,"storyCount":112355,"slug":"kurier","factuality":"high","owners":[{"id":610,"category":"mediaConglomerate","name":"Funke Mediengruppe"}]}},{"articleId":null,"createdAt":"2026-05-08T21:46:39.000Z","date":"2026-05-08T18:53:28.000Z","description":"Moscow has agreed to Donald Trump's ceasefire initiative. The Russian president's foreign policy adviser and the US president both announced that a three-day ceasefire would be in place.","originalDescription":"Moszkva beleegyezett Donald Trump tűzszüneti kezdeményezésébe. Az orosz elnök külpolitikai tanácsadója és az amerikai elnök is közölte, háromnapos tűzszünet jön.","lang":"hu","paywall":"no","refId":"a456d88a-1cf7-447e-a371-778899a2d309","sortData":{"locality":{"index":203,"labelData":"international","flag":"https://groundnews.b-cdn.net/assets/flags/120_120/HU.png"},"bias":{"index":328,"labelData":null},"date":{"index":265,"labelData":"2026-05-08T18:53:28.000Z"}},"specialIcon":null,"title":"Trump Has Arranged: the Guns in Ukraine Will Fall Silent for Three Days, Moscow and Kiev Have Both Agreed to the Ceasefire","originalTitle":"Trump elintézte: három napra elnémulnak a fegyverek Ukrajnában, Moszkva és Kijev is beleegyezett a fegyverszünetbe","url":"https://magyarnemzet.hu/kulfold/2026/05/oroszorszag-tuzszunetet-hirdetett","wireStoryId":null,"sourceInfo":{"bias":"unknown","biasRatings":[],"icon":"https://groundnews.b-cdn.net/interests/bd4af1090000dc9ee246aaa8ea67a99aeec4e127.jpg","id":"d3a2f9da-185d-490e-95bb-5cc6d9a0bdf3","interestId":"b2c7fd2c-c7b0-4f9f-bc0d-655fe918bd0a","location":{"lat":47.503719,"lon":19.037619},"name":"Magyar Nemzet","paywall":"no","place":[{"id":"Budapest,HU","name":"Budapest","type":"locality"},{"id":"HU","name":"Hungary","type":"country"}],"placeId":"Budapest,HU","storyCount":109851,"slug":"magyar-nemzet","factuality":"unknown","owners":[]}},{"articleId":null,"createdAt":"2026-05-09T01:19:03.000Z","date":"2026-05-08T19:38:00.000Z","description":"In the Russian war of aggression, the weapons should remain silent from 9 to 11 May. That is what US President Trump announces. Thus, the warring parties have also agreed on an exchange of prisoners.","originalDescription":"Im russischen Angriffskrieg sollen die Waffen vom 9. bis zum 11. Mai schweigen. Das gibt US-Präsident Trump bekannt. Auch auf einen Gefangenenaustausch haben sich die Kriegsparteien demnach geeinigt.","lang":"de","paywall":"yes","refId":"46a0b952-da4b-45b9-b8bd-e0c5df7ee560","sortData":{"locality":{"index":172,"labelData":"international","flag":"https://groundnews.b-cdn.net/assets/flags/120_120/DE.png"},"bias":{"index":30,"labelData":"leanLeft"},"date":{"index":351,"labelData":"2026-05-08T19:38:00.000Z"}},"sp