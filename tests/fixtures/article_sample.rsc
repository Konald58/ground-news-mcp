ters reports.","originalDescription":"Rusija ir Ukraina penktadienį patvirtino susitarusios dėl JAV tarpininkautų trijų dienų paliaubų, kurios galios nuo gegužės 9 iki 11 dienos, o JAV prezidentas Donaldas Trumpas teigė besitikintis, kad jos bus pratęstos, skelbia „Reuters“.","lang":"lt","paywall":"no","refId":"092f27af-1b3e-4387-8f03-77a8e4747be2","sortData":{"locality":{"index":194,"labelData":"international","flag":"https://groundnews.b-cdn.net/assets/flags/120_120/LT.png"},"bias":{"index":190,"labelData":"center"},"date":{"index":470,"labelData":"2026-05-09T03:24:00.000Z"}},"specialIcon":null,"title":"War in Ukraine. 245 Clashes Took Place on the Frontline in a Day, the Most Intense Battles Were in Pokrovsk","originalTitle":"Karas Ukrainoje. Per parą fronte įvyko 245 susirėmimai, intensyviausi mūšiai – Pokrovske","url":"https://www.lrt.lt/naujienos/pasaulyje/6/2923005/karas-ukrainoje-per-para-fronte-ivyko-245-susiremimai-intensyviausi-musiai-pokrovske","wireStoryId":"98835fca-0291-4526-b4b1-6aa5a172815e","sourceInfo":{"bias":"center","biasRatings":[{"reviewerId":"c17ff2cc-b919-439a-b390-1a9a4d08ba62","politicalBias":"center","referenceUrl":"https://mediabiasfactcheck.com/lithuanian-national-radio-and-television-lrt-bias/","sourceInfoId":"785c52f1-9305-4b5a-a647-c42c6aed3ae5","reviewer":{"id":"c17ff2cc-b919-439a-b390-1a9a4d08ba62","name":"Media Bias/Fact Check","icon":"https://b-cdn.ground.news/assets/external_source_reviewer_icons/mediaBiasFactCheck.png"}}],"icon":"https://groundnews.b-cdn.net/assets/letterIcons/square/AA00FF/L.png","id":"785c52f1-9305-4b5a-a647-c42c6aed3ae5","interestId":"ae20c72b-cc45-408d-b3cd-b5e71eddfb77","location":{"lat":54.689583,"lon":25.306968},"name":"Lietuvos Radijas ir Televizija","paywall":"no","place":[{"id":"Vilnius,Vilniuscitymunicipality,VilniusCounty,LT","name":"Vilnius","type":"locality"},{"id":"Vilniuscitymunicipality,VilniusCounty,LT","name":"Vilnius city municipality","type":"administrative_area_level_2"},{"id":"VilniusCou