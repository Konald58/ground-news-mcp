d Trump announced on Friday a three-day ceasefire between Ukraine and Russia starting Saturday.","originalDescription":"Donald Trump a annoncé vendredi un cessez-le-feu de trois jours entre l'Ukraine et la Russie à partir de samedi.","lang":"fr","paywall":"no","refId":"14b4066a-2c14-4567-898f-922983cd0359","sortData":{"locality":{"index":101,"labelData":"international","flag":"https://groundnews.b-cdn.net/assets/flags/120_120/CA.png"},"bias":{"index":37,"labelData":"leanLeft"},"date":{"index":71,"labelData":"2026-05-08T18:14:19.000Z"}},"specialIcon":null,"title":"Trump Announces a Three-Day Ceasefire Between Russia and Ukraine","originalTitle":"Trump annonce un cessez-le-feu de trois jours entre Russie et Ukraine","url":"https://www.tvanouvelles.ca/2026/05/08/trump-annonce-un-cessez-le-feu-de-trois-jours-entre-lukraine-et-la-russie-des-samedi","wireStoryId":"70596325-b231-4c02-a5ac-e6f73f6a86d6","sourceInfo":{"bias":"leanLeft","biasRatings":[{"reviewerId":"c17ff2cc-b919-439a-b390-1a9a4d08ba62","politicalBias":"leanLeft","referenceUrl":"https://mediabiasfactcheck.com/tva-nouvelles-bias/","sourceInfoId":"06a8b6b0-af7e-46f1-b8d5-58513633ab79","reviewer":{"id":"c17ff2cc-b919-439a-b390-1a9a4d08ba62","name":"Media Bias/Fact Check","icon":"https://b-cdn.ground.news/assets/external_source_reviewer_icons/mediaBiasFactCheck.png"}}],"icon":"https://groundnews.b-cdn.net/interests/b9e03f1cfe55ddb8ab3089e8be4a806486c50c79.jpg","id":"06a8b6b0-af7e-46f1-b8d5-58513633ab79","interestId":"be205fb3-2e7e-420e-9961-f1844c809409","location":{"lat":45.488927,"lon":-73.564621},"name":"TVA Nouvelles","paywall":"no","place":[{"id":"Montreal,QC,CA","name":"Montreal","type":"locality"},{"id":"QC,CA","name":"Quebec","type":"administrative_area_level_1"},{"id":"CA","name":"Canada","type":"country"},{"id":"CA","name":"Canada","type":"country"}],"placeId":"Montreal,QC,CA","storyCount":82620,"slug":"tva-nouvelles","factuality":"high","owners":[]}},{"articleId":null,"createdAt":"2026-05-09T08:46:23.0