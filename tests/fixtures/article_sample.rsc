s/flags/120_120/SE.png"},"bias":{"index":1,"labelData":"left"},"date":{"index":36,"labelData":"2026-05-08T18:03:48.000Z"}},"specialIcon":null,"title":"Ceasefire Between Russia and Ukraine on Victory Day","originalTitle":"Vapenvila mellan Ryssland och Ukraina på segerdagen","url":"https://www.aftonbladet.se/nyheter/a/8p5pXx/vapenvila-mellan-ryssland-och-ukraina-enligt-trump","wireStoryId":null,"sourceInfo":{"bias":"left","biasRatings":[{"reviewerId":"c17ff2cc-b919-439a-b390-1a9a4d08ba62","politicalBias":"left","referenceUrl":"https://mediabiasfactcheck.com/aftonbladet/","sourceInfoId":"2bebdc7d-131e-4ab1-ad04-d440ac9ae3eb","reviewer":{"id":"c17ff2cc-b919-439a-b390-1a9a4d08ba62","name":"Media Bias/Fact Check","icon":"https://b-cdn.ground.news/assets/external_source_reviewer_icons/mediaBiasFactCheck.png"}}],"icon":"https://groundnews.b-cdn.net/interests/5ad61e3f21618f0c100ea104bc45eb39a282d647.jpg","id":"2bebdc7d-131e-4ab1-ad04-d440ac9ae3eb","interestId":"e77547b4-c6c8-47b2-be42-a065d4655393","location":{"lat":59.313584,"lon":18.066129},"name":"Aftonbladet","paywall":"sometimes","place":[{"id":"Stockholm,StockholmCounty,SE","name":"Stockholm","type":"locality"},{"id":"StockholmCounty,SE","name":"Stockholm County","type":"administrative_area_level_1"},{"id":"SE","name":"Sweden","type":"country"}],"placeId":"Stockholm,StockholmCounty,SE","storyCount":29686,"slug":"aftonbladet","factuality":"mixed","owners":[{"id":354,"category":"mediaConglomerate","name":"Schibsted"},{"id":980,"category":"other","name":"Swedish Trade Union Confederation"}]}},{"articleId":null,"createdAt":"2026-05-08T20:08:31.000Z","date":"2026-05-08T19:08:05.000Z","description":"After Russian President Vladimir Putin announced a ceasefire for May 8th and 9th, and Ukraine had previously called for an indefinite truce starting May 6th, US President Donald Trump has now also weighed in. \"I am pleased to announce that there will be a three-day ceasefire (May 9th, 10th, and 11th) in the war between Russia and Ukraine,\" he wrote on his personal platform. \"This ceasefire includes a cessation of all hostilities as well as a pri…","originalDescription":"Nachdem der russische Präsident Wladimir Putin bereits einen Waffenstillstand für den 8. und 9. Mai angekündigt und die Ukraine zuvor eine unbefristete Waffenruhe ab dem 6. Mai gefordert hatte, hat sich nun auch US-Präsident Donald Trump zu Wort gemeldet. \"Ich freue mich, bekannt geben zu dürfen, dass es im Krieg zwischen Russland und der Ukraine einen dreitägigen Waffenstillstand (9., 10. und 11. Mai) geben wird\", schrieb er auf seiner persönli…","lang":"de","paywall":"no","refId":"e91b4a58-10fc-4c09-93ae-283b7333a325","sortData":{"locality":{"index":340,"labelData":"other","flag":null},"bias":{"index":459,"labelData":null},"date":{"index":292,"labelData":"2026-05-08T19:08:05.000Z"}},"specialIcon":null,"title":"Trump Announces Three-Day Ceasefire Between Russia and Ukraine","originalTitle":"Trump verkündet dreitägige Waffenruhe zwischen Russland und Ukraine","url":"https://www.berliner-sonntagsblatt.de/Deutschland/Trump-verkuendet-dreitaegige-Waffenruhe-zwischen-Russland-und-Ukraine-359420.html","wireStoryId":"1880b7b5-2a13-4927-90aa-5606f6332f6b","sourceInfo":{"bias":"unknown","biasRatings":[],"icon":"https://groundnews.b-cdn.net/assets/letterIcons/square/AA00FF/B.png","id":"5079f8bd-95ec-439f-8be2-8bca8a660c0c","interestId":"334d8beb-d996-4188-a80f-95c73c3be636","location":null,"name":"berliner-sonntagsblatt.de","paywall":"no","place":[],"placeId":null,"storyCount":29584,"slug":"berliner-sonntagsblattde","factuality":"unknown","owners":[]}},{"articleId":null,"createdAt":"2026-05-08T19:19:47.000Z","date":"2026-05-08T18:10:51.000Z","description":"US President Trump announced the introduction of a three-day truce between Russia and Ukraine on May 9, 10 and 11 and the exchange of prisoners","originalDescription":"Американський президент Трамп заявив про запровадження триденного перемир’я між Росією та Україною 9, 10 та 11 травня та обмін полоненими","lang":"uk","paywall":"no","refId":"d6b5712e-c070-41b8-abbc-04cbb0217fff","sortData":{"locality":{"index":341,"labelData":"other","flag":null},"bias":{"index":379,"labelData":null},"date":{"index":53,"labelData":"2026-05-08T18:10:51.000Z"}},"specialIcon":null,"title":"Trump Announced the Introduction of a Ceasefire Between Russia and Ukraine on May 9, 10 and 11 and Announced a New Exchange of Prisoners","originalTitle":"Трамп заявив про запровадження перемир’я між РФ і Україною 9, 10 та 11 травня й ананосував новий обмін полоненими","url":"https://babel.ua/news/126834-tramp-zayaviv-pro-zaprovadzhennya-tridennogo-peremir-ya-mizh-rf-ta-ukrajinoyu-9-10-ta-11-travnya","wireStoryId":null,"sourceInfo":{"bias":"unknown","biasRatings":[],"icon":"https://groundnews.b-cdn.net/interests/0b05489e33e9b0a590b7e0c5d67c31e8ff6d5fe3.jpg","id":"2117aa78-6e16-418d-a7f4-d60dab2123b6","interestId":"a79d7c43-f786-4cd9-b823-39865fed7bb2","location":null,"name":"babel.ua","paywall":"no","place":[],"placeId":null,"storyCount":29320,"slug":"babelua","factuality":"unknown","owners":[]}},{"articleId":null,"createdAt":"2026-05-09T16:53:12.000Z","date":"2026-05-08T18:23:41.000Z","description":"\"I am happy to report a three-day cease-fire (9, 10 and 11 May) in the war between Russia and Ukraine: Russia celebrates Victory Day, but it is also important in Ukraine, because it also played a significant role in World War II. This cease-fire will include the suspension of all hostilities, as well as the exchange of 1,000 prisoners from each country,\" the President of the United States wrote on May 8 on his social network True Social.","originalDescription":"\"С радостью сообщаю о трехдневном прекращении огня (9, 10 и 11 мая) в войне между Россией и Украиной. В России празднуют День победы, но и в Украине это тоже важно, поскольку она также сыграла значительную роль во Второй мировой войне. Это прекращение огня будет включать в себя приостановку всех боевых действий, а также обмен пленными по 1000 человек из каждой страны\", – написал президент США 8 мая в своей соцсети Truth Social.\nПо словам Трампа,…","lang":"ru","paywall":"no","refId":"1f542e2f-304a-4603-9b90-dfecdd02aed9","sortData":{"locality":{"index":187,"labelData":"international","flag":"https://groundnews.b-cdn.net/assets/flags/120_120/CZ.png"},"bias":{"index":460,"labelData":null},"date":{"index":118,"labelData":"2026-05-08T18:23:41.000Z"}},"specialIcon":null,"title":"Donald Trump Declared a Truce in the War of Russia and Ukraine From 9 to 11 May.","originalTitle":"Дональд Трамп объявил о перемирии в войне России и Украины с 9 по 11 мая","url":"https://www.currenttime.tv/a/donald-tramp-obyavil-o-peremirii/33752887.html","wireStoryId":null,"sourceInfo":{"bias":"unknown","biasRatings":[],"icon":"https://groundnews.b-cdn.net/assets/letterIcons/square/FF6D00/C.png","id":"4b1561a2-6fe9-49fc-a0bd-759fa0028d82","interestId":"3b452ab7-4148-43c7-89c0-33c7628a45f2","location":{"lat":50.075777,"lon":14.438259},"name":"currenttime.tv","paywall":"no","place":[{"id":"Prague,HlavníměstoPraha,Prague,CZ","name":"Prague","type":"locality"},{"id":"HlavníměstoPraha,Prague,CZ","name":"Hlavní město Praha","type":"administrative_area_level_2"},{"id":"CZ","name":"Czechia","type":"country"}],"placeId":"Prague,HlavníměstoPraha,Prague,CZ","storyCount":29294,"slug":"currenttimetv","factuality":"unknown","owners":[]}},{"articleId":null,"createdAt":"2026-05-08T21:41:48.000Z","date":"2026-05-08T18:12:00.000Z","description":"Ukraine and Russia have agreed to a three-day ceasefire, US President Donald Trump announces. In addition, 1,000 prisoners from each country will be exchanged.","originalDescription":"Ukraina och Ryssland är överens om en vapenvila i tre dagar, meddelar USA:s president Donald Trump. Dessutom ska 1 000 fångar från vardera land utväxlas.","lang":"sv","paywall":"no","refId":"94a32810-fe93-46d9-ae66-9cbcc9be622e","sortData":{"locality":{"index":169,"labelData":"international","flag":"h