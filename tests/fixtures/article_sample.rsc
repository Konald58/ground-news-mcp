rative_area_level_1"},{"id":"DE","name":"Germany","type":"country"}],"placeId":"BN,K,NRW,DE","storyCount":105054,"slug":"deutsche-welle","factuality":"veryHigh","owners":[{"id":1034,"category":"government","name":"Cabinet of Germany"}]}},{"articleId":null,"createdAt":"2026-05-09T04:09:17.000Z","date":"2026-05-08T19:20:36.000Z","description":"A surprising diplomatic success for the US President: Trump seems to be able to convince Kiev and Moscow of a temporary ceasefire and a large exchange of prisoners. The agreement is expected to enter into force within a few hours.","originalDescription":"Ein überraschender diplomatischer Erfolg für den US-Präsidenten: Trump kann Kiew und Moskau offenbar von einer befristeten Waffenruhe und einem großen Gefangenenaustausch überzeugen. Die Vereinbarung soll bereits in wenigen Stunden in Kraft treten.","lang":"de","paywall":"no","refId":"5f38072d-aaf5-4814-a3e5-e274300ec8b7","sortData":{"locality":{"index":284,"labelData":"other","flag":null},"bias":{"index":226,"labelData":"leanRight"},"date":{"index":327,"labelData":"2026-05-08T19:20:36.000Z"}},"specialIcon":null,"title":"Donald Trump Mediates Ceasefire Between Russia and Ukraine","originalTitle":"Donald Trump vermittelt Waffenruhe zwischen Russland und Ukraine","url":"https://www.n-tv.de/politik/Donald-Trump-vermittelt-Waffenruhe-zwischen-Russland-und-Ukraine-id30803038.html","wireStoryId":null,"sourceInfo":{"bias":"leanRight","biasRatings":[{"reviewerId":"0b06b55d-d3d4-4653-b4db-b22c77d812f7","politicalBias":"center","referenceUrl":"https://www.adfontesmedia.com/","sourceInfoId":"deb7a9c1-84f2-46e5-aedb-4b0c1f878701","reviewer":{"id":"0b06b55d-d3d4-4653-b4db-b22c77d812f7","name":"Ad Fontes Media","icon":"https://b-cdn.ground.news/assets/external_source_reviewer_icons/adFontes.png"}},{"reviewerId":"c17ff2cc-b919-439a-b390-1a9a4d08ba62","politicalBias":"leanRight","referenceUrl":"https://mediabiasfactcheck.com/n-tv-bias-and-credibility/","sourceInfoId":"deb7a9c1-84f2-46e5-aedb-4b0c1f878701","reviewer":{"id":"c17ff2cc-b919-439a-b390-1a9a4d08ba62","name":"Media Bias/Fact Check","icon":"https://b-cdn.ground.news/assets/external_source_reviewer_icons/mediaBiasFactCheck.png"}}],"icon":"https://groundnews.b-cdn.net/interests/7d56cf8c3e41d3cc87c549cd3093ece817b4a371.jpg","id":"deb7a9c1-84f2-46e5-aedb-4b0c1f878701","interestId":"d9649d92-008a-4fba-be6a-dbc4f3b89878","location":null,"name":"n-tv.de","paywall":"no","place":[],"placeId":null,"storyCount":104559,"slug":"n-tvde","factuality":"veryHigh","owners":[{"id":782,"category":"independent","name":"Bertelsmann Stiftung"}]}},{"articleId":null,"createdAt":"2026-05-09T02:47:45.000Z","date":"2026-05-08T18:38:10.000Z","description":"A three-day truce. Donald Trump announced it on Truth: from the 9th (i.e. tomorrow) to the 11th of May there will be a ceasefire in the war in Ukraine. The reason is that Russia celebrates victory in the Second World War. I am pleased to announce that there will be a three-day ceasefire in the war between Russia and Ukraine, wrote the U.S. president adding that the break of hostilities also provides for the exchange of a thousand prisoners for e…","originalDescription":"Una tregua di tre giorni. Lo ha annunciato Donald Trump su Truth: dal 9 (cioè domani) all’11 di maggio è previsto il cessate il fuoco nella guerra in Ucraina. La ragione è che la Russia celebra la vittoria nella Seconda Guerra Mondiale. “Sono lieto di annunciare che vi sarà un cessate il fuoco di tre giorni nella guerra tra Russia e Ucraina”, ha scritto il presidente statunitense aggiungendo che la pausa delle ostilità prevede anche lo scambio d…","lang":"it","paywall":"no","refId":"d391861e-bdf3-47d0-9d26-38c75f84060f","sortData":{"locality":{"index":204,"labelData":"international","flag":"https://groundnews.b-cdn.net/assets/flags/120_120/IT.png"},"bias":{"index":32,"labelData":"leanLeft"},"date":{"index":200,"labelData":"2026-05-08T18:38:10.000Z"}},"specialIcon":null,"title":"Truce Ukraine, Trump Announces Ceasefire 9-11 May","originalTitle":"Tregua Ucraina, Trump annuncia cessate il fuoco 9-11 maggio","url":"https://www.ilfattoquotidiano.it/2026/05/08/tregua-ucraina-trump-cessate-fuoco-notizie/8379990/","wireStoryId":null,"sourceInfo":{"bias":"leanLeft","biasRatings":[{"reviewerId":"c17ff2cc-b919-439a-b390-1a9a4d08ba62","politicalBias":"leanLeft","referenceUrl":"https://mediabiasfactcheck.com/il-fatto-quotidiano-bias/","sourceInfoId":"192b5059-c3d2-4308-b93e-f7b246134cb6","reviewer":{"id":"c17ff2cc-b919-439a-b390-1a9a4d08ba62","name":"Media Bias/Fact Check","icon":"https://b-cdn.ground.news/assets/external_source_reviewer_icons/mediaBiasFactCheck.png"}}],"icon":"https://groundnews.b-cdn.net/interests/d9b399f6a74f2f31ff29f6e28661a006ef00b8ea.jpg","id":"192b5059-c3d2-4308-b93e-f7b246134cb6","interestId":"01df5d87-0ba6-47b4-8034-53f9ac513c81","location":{"lat":41.912766,"lon":12.51687},"name":"Il Fatto Quotidiano","paywall":"no","place":[{"id":"Rome,RM,Lazio,IT","name":"Rome","type":"locality"},{"id":"RM,Lazio,IT","name":"Metropolitan City of Rome","type":"administrative_area_level_2"},{"id":"Lazio,IT","name":"Lazio","type":"administrative_area_level_1"},{"id":"IT","name":"Italy","type":"country"}],"placeId":"Rome,RM,Lazio,IT","storyCount":103715,"slug":"il-fatto-nuotidiano","factuality":"high","owners":[]}},{"articleId":null,"createdAt":"2026-05-08T20:54:33.000Z","date":"2026-05-08T19:55:53.000Z","description":"WASHINGTON — President Donald Trump said Friday that the leaders of Russia and Ukraine have agreed to his request for a three-day ceasefire and an exchange of prisoners, adding that such a halt to hostilities could be the “beginning of the end” of the long war between them.","originalDescription":null,"lang":"en","paywall":"yes","refId":"2575f37e-f42d-4b10-b8a9-44d7cc7af369","sortData":{"locality":{"index":21,"labelData":"national","flag":"https://groundnews.b-cdn.net/assets/flags/120_120/US.png"},"bias":{"index":103,"labelData":"center"},"date":{"index":367,"l