/letterIcons/square/FFD600/I.png","id":"573df5ec-7886-4ce7-8e9a-3df639920522","interestId":"2ce57447-5a19-451d-b6f4-3c0901d15d51","location":null,"name":"island.lk","paywall":"no","place":[],"placeId":null,"storyCount":182,"slug":"islandlk","factuality":"unknown","owners":[]}},{"articleId":null,"createdAt":"2026-05-08T21:55:25.000Z","date":"2026-05-08T20:04:30.000Z","description":"Washington — President Trump on Friday announced Russia and Ukraine will swap 1,000 prisoners as a part of a three-day ceasefire for the observation of Victory Day in Russia this weekend.  Russia and Ukraine previously announced separate ceasefires on different days, so the timeline isn’t entirely clear. Mr. Trump said the temporary ceasefire will suspend all kinetic activity Saturday through Monday. In statements, Ukraine and Russia appeared to…","originalDescription":null,"lang":"en","paywall":"no","refId":"61a94b98-3236-4acc-b83d-d38311edb0f9","sortData":{"locality":{"index":94,"labelData":"national","flag":"https://groundnews.b-cdn.net/assets/flags/120_120/US.png"},"bias":{"index":532,"labelData":null},"date":{"index":372,"labelData":"2026-05-08T20:04:30.000Z"}},"specialIcon":null,"title":"Trump announces prisoner swap in 3-day Russia-Ukraine ceasefire","originalTitle":null,"url":"https://www.us-inquirer.com/story/trump-announces-prisoner-swap-in-3-day-russia-ukraine-ceasefire/","wireStoryId":null,"sourceInfo":{"bias":"unknown","biasRatings":[],"icon":"https://groundnews.b-cdn.net/assets/letterIcons/square/FFAB00/U.png","id":"bbe29ef5-975e-498e-910d-c18af0b8fea3","interestId":"2b7978d1-9f3a-4187-9cdc-59c97fa730a0","location":{"lat":35.484809,"lon":-97.514399},"name":"us-inquirer.com","paywall":"no","place":[{"id":"OklahomaCity,OklahomaCounty,OK,US","name":"Oklahoma City","type":"locality"},{"id":"OklahomaCounty,OK,US","name":"Oklahoma County","type":"administrative_area_level_2"},{"id":"OK,US","name":"Oklahoma","type":"administrative_area_level_1"},{"id":"US","name":"United States","type":"country"}],"placeId":"OklahomaCity,OklahomaCounty,OK,US","storyCount":100,"slug":"us-inquirercom","factuality":"unknown","owners":[]}},{"articleId":null,"createdAt":"2026-05-09T09:16:52.000Z","date":"2026-05-09T04:53:27.000Z","description":"WASHINGTON (AP) — President Donald Trump says the leaders of Russia and Ukraine have agreed to his request for a three-day ceasefire and an exchange of prisoners. Trump said Friday that such a halt to hostilities could be the “beginning of the end” of the long war between them. He told reporters at the White House that he asked for the ceasefire and both presidents agreed. Trump announced on social media that the ceasefire would run Saturday thr…","originalDescription":null,"lang":"en","paywall":"no","refId":"d78be73a-24e3-4c1e-aec9-5ddbaa4ac53b","sortData":{"locality":{"index":532,"labelData":"other","flag":null},"bias":{"index":313,"labelData":"right"},"date":{"index":481,"labelData":"2026-05-09T04:53:27.000Z"}},"specialIcon":null,"title":"Trump Says Russia and Ukraine Have Agreed to His Request for a 3-day Ceasefire and a Prisoner Swap","originalTitle":null,"url":"https://www.wbap.com/2026/05/08/trump-says-russia-and-ukraine-have-agreed-to-his-request-for-a-3-day-ceasefire-and-a-prisoner-swap/","wireStoryId":"72434a09-f786-417c-a537-a31c4217cb53","sourceInfo":{"bias":"right","biasRatings":[{"reviewerId":"c17ff2cc-b919-439a-b390-1a9a4d08ba62","politicalBias":"right","referenceUrl":"https://mediabiasfactcheck.com/wbap-820am-dallas-bias/","sourceInfoId":"640590a4-3c21-4cfa-b9ac-68cd7644e746","reviewer":{"id":"c17ff2cc-b919-439a-b390-1a9a4d08ba62","name":"Media Bias/Fact Check","icon":"https://b-cdn.ground.news/assets/external_source_reviewer_icons/mediaBiasFactCheck.png"}}],"icon":"https://groundnews.b-cdn.net/assets/letterIcons/square/00C853/W.png","id":"640590a4-3c21-4cfa-b9ac-68cd7644e746","interestId":"ddd1f66d-aba3-4896-a3eb-24fa60126fba","location":null,"name":"wbap.com","paywall":"no","place":[],"placeId":null,"storyC